    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "playwright": "1.61.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
