    "gen:controls": "node scripts/gen-controls.mjs",
    "walk": "node e2e/walk.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
